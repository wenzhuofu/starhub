#!/usr/bin/env python3
"""starhub — 管理 GitHub star 项目的目录与 VPS 上的 skill 库（仅用标准库）。

  starhub install               首次安装：链接 CLI 与 /starhub skill，拉取 VPS 上的 skill
  starhub show <q> [关键词]     查看项目详情；已拉取的列出其中每个 skill
  starhub review                复盘报告（只读）：待分拣、已取消 star、上游更新、闲置项目
  starhub sync                  对比 GitHub star 列表：新 star 追加为 inbox
  starhub triage                用 Claude API 草拟 inbox 条目（默认 claude-haiku-5-5，STARHUB_MODEL 可改）
  starhub vendor [q...]         按固定 ref 稀疏拉取 host=vps 的项目到 vendor 库
  starhub outdated              列出上游已有新提交的项目
  starhub bump <q> [sha]        把 ref 升到上游 HEAD（或指定 sha），并重新拉取
  starhub set <q> <字段> <值>   修改某个字段，如 status active
  starhub log <q> <备注>        记录一次使用到 usage.jsonl
  starhub index                 由 catalog.toml 生成 INDEX.md 与 README 目录
"""
import datetime
import json
import os
import re
import subprocess
import sys
import tomllib
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
CATALOG = ROOT / "catalog.toml"
VENDOR = Path(os.environ.get("STARHUB_VENDOR", Path.home() / ".local/share/starhub/vendor"))
HOST_LABEL = {"vps": "VPS", "pc-home": "pc-home", "remote": "远程读取", "hosted": "在线版",
              "server": "独立服务器", "none": "未部署", "?": "?"}
STATUS_ORDER = ["active", "trial", "backlog", "inbox", "archived"]


def load():
    with open(CATALOG, "rb") as f:
        return tomllib.load(f)


def projects(data=None):
    return (data or load()).get("project", [])


def vendor_dir(repo):
    return VENDOR / repo.replace("/", "__")


def find(q, data=None):
    ps = projects(data)
    exact = [p for p in ps if p["repo"].lower() == q.lower()]
    if exact:
        return exact[0]
    hits = [p for p in ps if q.lower() in p["repo"].lower()]
    if len(hits) == 1:
        return hits[0]
    sys.exit(f"'{q}' 匹配到 {len(hits)} 个项目：" + ", ".join(p["repo"] for p in hits) if hits
             else f"没有匹配 '{q}' 的项目")


def git(*args, cwd=None, check=True):
    return subprocess.run(["git", *args], cwd=cwd, check=check, text=True,
                          capture_output=True).stdout.strip()


# ───────────── frontmatter ─────────────

def frontmatter(path):
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return {}
    m = re.match(r"^---\s*\n(.*?)\n---", text, re.S)
    if not m:
        return {}
    out, key = {}, None
    for line in m.group(1).splitlines():
        km = re.match(r"^([A-Za-z_-]+):\s*(.*)$", line)
        if km:
            key, val = km.group(1), km.group(2).strip()
            out[key] = "" if val in (">", "|", ">-", "|-") else val.strip("\"'")
        elif key and line.startswith((" ", "\t")):
            out[key] = (out[key] + " " + line.strip()).strip()
    return out


def list_skills(p):
    d = vendor_dir(p["repo"])
    if not d.exists():
        return None
    roots = [d / s for s in p.get("skills", [])] or [d]
    found = []
    for r in roots:
        for f in sorted(r.rglob("SKILL.md")) if r.exists() else []:
            if any(part.startswith(".") for part in f.relative_to(d).parts):
                continue
            fm = frontmatter(f)
            found.append((f, fm.get("name", f.parent.name), fm.get("description", "")))
    return found


# ───────────── commands ─────────────

def cmd_index(_args):
    data = load()
    cats = data["meta"]["categories"]
    ps = projects(data)
    by_cat = {}
    for p in ps:
        by_cat.setdefault(p.get("category", "?"), []).append(p)

    def tag(p):
        return f"{p.get('type','?')}·{p.get('host','?')}·{p.get('status','?')}"

    # INDEX.md — L0，给 agent 看，一行一个，排除 archived
    lines = ["# starhub INDEX", "",
             "<!-- 由 bin/starhub index 生成，勿手改 -->",
             "格式：`repo [类型·位置·状态] 作用 → 何时用 ⚔冲突`。详情：`starhub show <repo>`。", ""]
    inbox = [p for p in ps if p.get("status") == "inbox"]
    for c, title in cats.items():
        items = [p for p in by_cat.get(c, []) if p.get("status") not in ("archived", "inbox")]
        if not items:
            continue
        lines.append(f"## {title}")
        for p in sorted(items, key=lambda p: STATUS_ORDER.index(p.get("status", "backlog"))):
            cf = " ⚔" + ",".join(x.split("/")[1] for x in p.get("conflicts", [])) if p.get("conflicts") else ""
            lines.append(f"- {p['repo']} [{tag(p)}] {p.get('summary','')} → {p.get('when','')}{cf}")
        lines.append("")
    if inbox:
        lines.append("## 待分拣（inbox）")
        lines += [f"- {p['repo']} {p.get('summary','')}" for p in inbox]
        lines.append("")
    archived = sum(p.get("status") == "archived" for p in ps)
    lines.append(f"_共 {len(ps)} 个项目，其中归档 {archived} 个未列出。_")
    (ROOT / "INDEX.md").write_text("\n".join(lines) + "\n", encoding="utf-8")

    # README 目录 — 给人看
    out = []
    counts = {}
    for p in ps:
        counts[p.get("host", "?")] = counts.get(p.get("host", "?"), 0) + 1
    out.append("| 部署位置 | 数量 |\n|---|---|")
    out += [f"| {HOST_LABEL.get(h, h)} | {n} |" for h, n in sorted(counts.items(), key=lambda x: -x[1])]
    out.append("")
    for c, title in list(cats.items()) + [("?", "待分拣")]:
        items = by_cat.get(c, [])
        if not items:
            continue
        out.append(f"### {title}\n")
        out.append("| 项目 | 类型 | 部署 | 状态 | 作用 | 何时用 |\n|---|---|---|---|---|---|")
        for p in items:
            esc = lambda s: str(s).replace("|", "\\|")
            out.append(f"| [{p['repo']}](https://github.com/{p['repo']}) | {p.get('type','?')} | "
                       f"{HOST_LABEL.get(p.get('host','?'), p.get('host'))} | {p.get('status','?')} | "
                       f"{esc(p.get('summary',''))} | {esc(p.get('when',''))} |")
        out.append("")
    readme = ROOT / "README.md"
    text = readme.read_text(encoding="utf-8")
    block = "<!-- catalog:start -->\n" + "\n".join(out) + "<!-- catalog:end -->"
    text = re.sub(r"<!-- catalog:start -->.*?<!-- catalog:end -->", lambda _: block, text, flags=re.S)
    readme.write_text(text, encoding="utf-8")
    print(f"INDEX.md 与 README.md 已更新（{len(ps)} 个项目）")


def cmd_show(args):
    if not args:
        sys.exit("用法：starhub show <q>")
    p = find(args[0])
    for k, v in p.items():
        print(f"{k:10} {', '.join(v) if isinstance(v, list) else v}")
    print(f"{'github':10} https://github.com/{p['repo']}")
    if p.get("host") != "vps":
        return
    sk = list_skills(p)
    if sk is None:
        print(f"\n尚未拉取：starhub vendor {p['repo']}")
        return
    d = vendor_dir(p["repo"])
    print(f"{'vendor':10} {d}")
    if sk:
        uniq, copies = {}, {}
        for f, name, desc in sk:
            copies[name] = copies.get(name, 0) + 1
            uniq.setdefault(name, (f, desc))
        kw = " ".join(args[1:]).lower()
        items = [(n, f, ds) for n, (f, ds) in uniq.items() if not kw or kw in (n + ds).lower()]
        compact = len(items) > 25
        print(f"\n{len(uniq)} 个 skill" + (f"（同名副本 {len(sk) - len(uniq)} 份已合并）" if len(sk) > len(uniq) else "")
              + (f"，匹配“{kw}”的 {len(items)} 个" if kw else "") + "。按需 Read 对应 SKILL.md"
              + ("；数量较多，可用 starhub show <q> <关键词> 过滤：" if compact else "："))
        for n, f, ds in items:
            dup = f" [×{copies[n]}]" if copies[n] > 1 else ""
            if compact:
                print(f"- {n}{dup}: {ds[:90]}  ← {f.relative_to(d)}")
            else:
                print(f"- {n}{dup}: {ds[:180]}\n    {f}")
    else:
        for s in p.get("skills", []) or ["."]:
            entries = sorted(x.name for x in (d / s).iterdir()) if (d / s).is_dir() else []
            print(f"\n{s}/ 下 {len(entries)} 项：{' '.join(entries[:100])}")


def vendor_one(p):
    d = vendor_dir(p["repo"])
    ref = p.get("ref")
    if not ref:
        print(f"跳过 {p['repo']}：缺少 ref")
        return
    url = f"https://github.com/{p['repo']}.git"
    if not (d / ".git").exists():
        d.mkdir(parents=True, exist_ok=True)
        git("init", "-q", cwd=d)
        git("remote", "add", "origin", url, cwd=d)
    paths = p.get("skills", [])
    if paths:
        git("sparse-checkout", "set", *paths, cwd=d)
    else:
        git("sparse-checkout", "disable", cwd=d, check=False)
    git("fetch", "-q", "--depth", "1", "--filter=blob:none", "origin", ref, cwd=d)
    git("checkout", "-q", "--detach", "FETCH_HEAD", cwd=d)
    sk = list_skills(p) or []
    print(f"✓ {p['repo']} @ {ref[:7]} → {d}（{len(sk)} 个 skill）")


def cmd_vendor(args):
    targets = [find(q) for q in args] if args else \
        [p for p in projects() if p.get("host") == "vps" and p.get("status") != "archived"
         and p.get("type") in ("skill", "resource", "skill+tool")]
    for p in targets:
        try:
            vendor_one(p)
        except subprocess.CalledProcessError as e:
            print(f"✗ {p['repo']}: {e.stderr.strip()[:300]}")


def github_stars(user):
    stars, page = [], 1
    while True:
        req = urllib.request.Request(
            f"https://api.github.com/users/{user}/starred?per_page=100&page={page}",
            headers={"Accept": "application/vnd.github+json", "User-Agent": "starhub"})
        tok = os.environ.get("GITHUB_TOKEN")
        if tok:
            req.add_header("Authorization", f"Bearer {tok}")
        with urllib.request.urlopen(req, timeout=30) as r:
            batch = json.load(r)
        stars += batch
        if len(batch) < 100:
            return stars
        page += 1


def today():
    return datetime.date.today().isoformat()


def star_diff(data):
    stars = github_stars(data["meta"]["github_user"])
    known = {p["repo"].lower() for p in projects(data)}
    starred = {s["full_name"].lower() for s in stars}
    new = [s for s in stars if s["full_name"].lower() not in known]
    gone = [p["repo"] for p in projects(data)
            if p["repo"].lower() not in starred and p.get("status") != "archived"]
    return stars, new, gone


def cmd_sync(_args):
    data = load()
    stars, new, gone = star_diff(data)
    if new:
        with open(CATALOG, "a", encoding="utf-8") as f:
            for s in new:
                f.write("\n[[project]]\n"
                        f"repo = {json.dumps(s['full_name'])}\n"
                        f'added = "{today()}"\n'
                        'type = "?"\ncategory = "?"\nhost = "?"\nstatus = "inbox"\n'
                        f"summary = {json.dumps(s.get('description') or '', ensure_ascii=False)}\n"
                        'when = ""\n'
                        f"notes = {json.dumps('语言 %s · ★%s · 待分拣' % (s.get('language') or '-', s.get('stargazers_count')), ensure_ascii=False)}\n")
    print(f"GitHub star {len(stars)} 个；目录 {len(projects(data))} 个")
    print(f"新增 {len(new)} 个（已追加为 inbox）：" + ", ".join(s["full_name"] for s in new) if new else "无新增")
    if gone:
        print("已取消 star 但未归档：" + ", ".join(gone) + "\n  → starhub set <repo> status archived")
    if new:
        print("下一步：starhub triage（或由 agent 读 README 分拣），再 starhub index")


def remote_head(repo):
    try:
        return git("ls-remote", f"https://github.com/{repo}.git", "HEAD").split()[0]
    except (subprocess.CalledProcessError, IndexError):
        return None


def outdated(data=None):
    rows = []
    for p in projects(data):
        if not p.get("ref") or p.get("status") == "archived":
            continue
        head = remote_head(p["repo"])
        if head is None:
            rows.append(f"? {p['repo']}: 无法访问（仓库可能被删除或改名）")
        elif head != p["ref"]:
            rows.append(f"↑ {p['repo']}: {p['ref'][:7]} → {head[:7]}  "
                        f"https://github.com/{p['repo']}/compare/{p['ref'][:12]}...{head[:12]}")
    return rows


def cmd_outdated(_args):
    print("\n".join(outdated()) or "全部是最新")


def usage_by_repo():
    last, count = {}, {}
    f = ROOT / "usage.jsonl"
    if f.exists():
        for line in f.read_text(encoding="utf-8").splitlines():
            if line.strip():
                r = json.loads(line)
                count[r["repo"]] = count.get(r["repo"], 0) + 1
                last[r["repo"]] = max(last.get(r["repo"], ""), r["date"])
    return last, count


def cmd_review(_args):
    """只读复盘报告，Markdown 输出（供人看、也作为自动维护 PR 的正文）。"""
    data = load()
    ps = projects(data)
    out = [f"# starhub 复盘 {today()}", ""]

    pending = [p for p in ps if p.get("status") == "inbox" or "AI 草拟" in p.get("notes", "")]
    out.append(f"## 待确认的新项目（{len(pending)}）")
    out += [f"- `{p['repo']}` [{p.get('type')}·{p.get('host')}·{p.get('status')}] {p.get('summary','')}"
            for p in pending] or ["- 无"]

    try:
        _, new, gone = star_diff(data)
        if new:
            out.append(f"- 另有 {len(new)} 个新 star 尚未同步：" + ", ".join(s["full_name"] for s in new)
                       + " → `starhub sync`")
        out += ["", f"## 已取消 star（{len(gone)}）"]
        out += [f"- `{r}` → `starhub set {r} status archived`" for r in gone] or ["- 无"]
    except OSError as e:
        out += ["", f"## 已取消 star\n- 无法访问 GitHub API：{e}"]

    rows = outdated(data)
    out += ["", f"## 上游有更新（{len(rows)}）", "审阅 compare 链接后再 `starhub bump <repo>`；不会自动升级。"]
    out += [f"- {r}" for r in rows] or ["- 无"]

    last, count = usage_by_repo()
    cutoff = (datetime.date.today() - datetime.timedelta(days=90)).isoformat()
    idle = [p for p in ps if p.get("status") in ("trial", "active")
            and p.get("added", "9999") < cutoff and last.get(p["repo"], "") < cutoff]
    out += ["", f"## 90 天未使用的 trial/active（{len(idle)}）"]
    out += [f"- `{p['repo']}`（最近使用：{last.get(p['repo'], '从未')}）→ 降为 backlog 或归档？" for p in idle] or ["- 无"]
    used = sorted(count.items(), key=lambda x: -x[1])[:10]
    out += ["", "## 使用最多"]
    out += [f"- `{r}` × {n}（最近 {last[r]}）" for r, n in used] or ["- 暂无使用记录"]
    print("\n".join(out))


TRIAGE_SCHEMA = {
    "type": "object",
    "properties": {
        "type": {"type": "string", "description": "skill | tool | app | model | resource，可用 + 组合"},
        "category": {"type": "string"},
        "host": {"type": "string", "enum": ["vps", "pc-home", "remote", "hosted", "server", "none"]},
        "summary": {"type": "string", "description": "中文，一句话说清它是什么、能做什么"},
        "when": {"type": "string", "description": "中文，什么任务时该用它"},
        "skills": {"type": "array", "items": {"type": "string"},
                   "description": "面向用户的 skill 目录（相对仓库根），不含 .claude/.agents 等内部开发 skill"},
        "setup": {"type": "string", "description": "pc-home 上的安装命令，非 pc-home 留空"},
        "needs": {"type": "string"},
        "conflicts": {"type": "array", "items": {"type": "string"}, "description": "目录中功能重叠的 repo"},
        "notes": {"type": "string", "description": "注意事项：风险、易错点；没有就留空"},
    },
    "required": ["type", "category", "host", "summary", "when", "skills", "setup", "needs",
                 "conflicts", "notes"],
    "additionalProperties": False,
}


def http_get(url, accept="application/vnd.github+json"):
    req = urllib.request.Request(url, headers={"Accept": accept, "User-Agent": "starhub"})
    if os.environ.get("GITHUB_TOKEN") and "api.github.com" in url:
        req.add_header("Authorization", f"Bearer {os.environ['GITHUB_TOKEN']}")
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read().decode("utf-8", errors="replace")


def cmd_triage(_args):
    try:
        import anthropic
    except ImportError:
        sys.exit("需要 Anthropic SDK：pip install anthropic（以及 ANTHROPIC_API_KEY）")
    model = os.environ.get("STARHUB_MODEL", "claude-haiku-5-5")
    data = load()
    inbox = [p for p in projects(data) if p.get("status") == "inbox"]
    if not inbox:
        print("没有 inbox 项目")
        return
    client = anthropic.Anthropic()
    cats = data["meta"]["categories"]
    existing = "\n".join(f"- {p['repo']}: {p.get('summary','')}" for p in projects(data)
                         if p.get("status") != "inbox")
    system = (
        "你在为一个 GitHub star 目录分拣新项目，输出一条 JSON 目录条目。\n"
        f"category 从这些里选（键名）：{json.dumps(cats, ensure_ascii=False)}；都不合适就新起一个英文短键。\n"
        "host 规则：纯 markdown 或只带轻量脚本的 agent skill、资料合集 → vps；需要安装 CLI、MCP server、"
        "Docker、GPU 或长期运行服务的 → pc-home；只需在线阅读的榜单 → remote；有官方在线版的重型应用 → hosted；"
        "需独立服务器部署的服务端 → server。\n"
        "summary、when、notes 用简洁中文。只依据提供的 README 和文件列表，不确定的写进 notes。\n"
        f"目录中已有项目（用于判断 conflicts）：\n{existing}")
    for p in inbox:
        repo = p["repo"]
        try:
            readme = http_get(f"https://api.github.com/repos/{repo}/readme", "application/vnd.github.raw")
            tree = json.loads(http_get(f"https://api.github.com/repos/{repo}/git/trees/HEAD?recursive=1"))
            paths = [t["path"] for t in tree.get("tree", []) if t["type"] == "blob"]
        except OSError as e:
            print(f"✗ {repo}: 读取失败 {e}")
            continue
        notable = [x for x in paths if x.endswith("SKILL.md") or x in (
            "package.json", "pyproject.toml", "Cargo.toml", "go.mod", "Dockerfile", "docker-compose.yml",
            ".claude-plugin/marketplace.json", ".mcp.json")]
        user = (f"仓库：{repo}\nGitHub 描述：{p.get('summary','')}\n"
                f"关键文件（共 {len(paths)} 个文件）：\n" + "\n".join(notable[:300]) +
                f"\n\nREADME：\n{readme}")
        try:
            resp = client.messages.create(
                model=model, max_tokens=4000,
                output_config={"effort": "low",
                               "format": {"type": "json_schema", "schema": TRIAGE_SCHEMA}},
                system=system, messages=[{"role": "user", "content": user}])
        except anthropic.RateLimitError:
            print(f"✗ {repo}: 触发限流，稍后重试")
            continue
        except anthropic.APIStatusError as e:
            print(f"✗ {repo}: API 错误 {e.status_code} {e.message}")
            continue
        except anthropic.APIConnectionError:
            print(f"✗ {repo}: 网络错误")
            continue
        if resp.stop_reason != "end_turn":
            print(f"✗ {repo}: 未完成（stop_reason={resp.stop_reason}），留在 inbox")
            continue
        entry = json.loads(next(b.text for b in resp.content if b.type == "text"))
        entry["notes"] = (entry.get("notes", "") + f"（AI 草拟 · {model}，待确认）").strip()
        head = remote_head(repo)
        for k in ("type", "category", "host", "summary", "when", "skills", "setup", "needs",
                  "conflicts", "notes"):
            if entry.get(k):
                set_field(repo, k, entry[k])
        if head:
            set_field(repo, "ref", head)
        set_field(repo, "status", "backlog")
        print(f"✓ {repo} → {entry['category']} · {entry['host']} · {entry['summary'][:60]}")


def cmd_install(_args):
    bin_link = Path.home() / ".local/bin/starhub"
    skill_link = Path.home() / ".claude/skills/starhub"
    for link, target in ((bin_link, ROOT / "bin/starhub"), (skill_link, ROOT / "skills/starhub")):
        link.parent.mkdir(parents=True, exist_ok=True)
        if link.is_symlink() or not link.exists():
            link.unlink(missing_ok=True)
            link.symlink_to(target)
            print(f"✓ {link} → {target}")
        else:
            print(f"跳过 {link}：已存在且不是链接")
    cmd_vendor([])
    print("\n完成。对话里输入 /starhub <任务> 使用，/starhub 维护 做复盘。")


def set_field(repo, field, value):
    text = CATALOG.read_text(encoding="utf-8")
    m = re.search(r'^\[\[project\]\]\nrepo = "' + re.escape(repo) + r'"\n', text, re.M)
    if not m:
        sys.exit(f"catalog 中找不到 {repo}")
    nxt = re.search(r"^\[", text[m.end():], re.M)
    end = m.end() + (nxt.start() if nxt else len(text) - m.end())
    block = text[m.start():end]
    line = f"{field} = {json.dumps(value, ensure_ascii=False)}"
    if re.search(rf"^{re.escape(field)} = .*$", block, re.M):
        block = re.sub(rf"^{re.escape(field)} = .*$", lambda _: line, block, count=1, flags=re.M)
    else:
        block = block.replace(f'repo = "{repo}"\n', f'repo = "{repo}"\n{line}\n', 1)
    CATALOG.write_text(text[:m.start()] + block + text[end:], encoding="utf-8")


def cmd_set(args):
    if len(args) != 3:
        sys.exit("用法：starhub set <q> <字段> <值>")
    p = find(args[0])
    set_field(p["repo"], args[1], args[2])
    print(f"{p['repo']}.{args[1]} = {args[2]}")


def cmd_bump(args):
    if not args:
        sys.exit("用法：starhub bump <q> [sha]")
    p = find(args[0])
    sha = args[1] if len(args) > 1 else \
        git("ls-remote", f"https://github.com/{p['repo']}.git", "HEAD").split()[0]
    set_field(p["repo"], "ref", sha)
    print(f"{p['repo']} ref → {sha[:7]}")
    if vendor_dir(p["repo"]).exists():
        vendor_one(find(p["repo"]))


def cmd_log(args):
    if len(args) < 2:
        sys.exit("用法：starhub log <q> <备注>")
    p = find(args[0])
    rec = {"date": today(), "repo": p["repo"], "note": " ".join(args[1:])}
    with open(ROOT / "usage.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
    print("已记录：", rec)


COMMANDS = {"install": cmd_install, "index": cmd_index, "show": cmd_show, "review": cmd_review,
            "sync": cmd_sync, "triage": cmd_triage, "vendor": cmd_vendor, "outdated": cmd_outdated,
            "bump": cmd_bump, "set": cmd_set, "log": cmd_log}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.exit(__doc__)
    COMMANDS[sys.argv[1]](sys.argv[2:])
